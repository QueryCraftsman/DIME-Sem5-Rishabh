// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  ideas         Idea[]
  notes         Note[]
  tasks         WorkspaceTask[]
  datasets      UserDataset[]
  notifications Notification[]
  preference    UserPreference?
  comparisons   ComparisonReport[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Idea {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text
  targetAudience String
  industry       String
  status         String   @default("DRAFT") // DRAFT, ANALYZING, VALIDATED, REJECTED

  // Validation Metrics from API
  feasibilityScore Float?
  marketDemand     Float?
  competitionLevel Float?
  innovationScore  Float?
  overallViability Float?

  // Scores from similarity/sentiment analysis pipeline
  noveltyScore     Float?
  marketPainScore  Float?
  opportunityScore Float?

  // Additional creation parameters
  analysisDepth         String?
  budget                String?
  formFactors           String?
  preferredTechnologies String?
  teamSize              String?
  timeline              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes Note[]
  tasks WorkspaceTask[]
  comparisonCandidates ComparisonCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPreference {
  id                             String   @id @default(cuid())
  userId                         String   @unique
  theme                          String   @default("system")
  emailNotifications             Boolean  @default(true)
  analysisCompletedNotifications Boolean  @default(true)
  analysisFailedNotifications    Boolean  @default(true)
  weeklyDigest                   Boolean  @default(false)
  defaultAnalysisDepth           String   @default("STANDARD")
  defaultWorkspaceView           String   @default("overview")
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  category  String   @default("General")
  tone      String   @default("orange")
  isPinned  Boolean  @default(false)
  userId    String
  ideaId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea Idea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([ideaId])
}

model WorkspaceTask {
  id        String    @id @default(cuid())
  title     String
  status    String    @default("TODO") // TODO, DONE
  priority  String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  dueDate   DateTime?
  assignee  String?
  userId    String
  ideaId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea Idea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([userId, status, updatedAt])
  @@index([ideaId])
}

model UserDataset {
  id           String   @id @default(cuid())
  datasetKey   String
  isBookmarked Boolean  @default(false)
  isImported   Boolean  @default(false)
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, datasetKey])
  @@index([userId, updatedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model ComparisonReport {
  id                 String                @id @default(cuid())
  reportNumber       Int                   @default(autoincrement())
  userId             String
  title              String
  description        String?               @db.Text
  objective          String                @default("Choose the best opportunity for an MVP")
  status             String                @default("COMPLETED") // DRAFT, RUNNING, COMPLETED, FAILED
  methodologyVersion String                @default("Multi-Vector Pareto Synthesis v3.4")
  selectedWeights    String?               @db.Text // JSON string
  recommendation     String?               @db.Text // JSON string
  paretoFrontier     String?               @db.Text // JSON string
  dataComparability  String?               @db.Text // JSON string
  executiveTakeaway  String?               @db.Text // JSON string
  candidatesCount    Int                   @default(2)
  durationMs         Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  completedAt        DateTime?

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidates         ComparisonCandidate[]

  @@index([userId, createdAt])
  @@index([status])
}

model ComparisonCandidate {
  id                String           @id @default(cuid())
  comparisonId      String
  ideaId            String
  analysisId        String
  candidatePosition Int              // 1, 2, 3, 4
  ideaTitle         String
  ideaDomain        String?
  ideaDescription   String?          @db.Text
  analysisScore     Float?
  scores            String?          @db.Text // JSON string of normalized metric vectors
  strengths         String?          @db.Text // JSON string
  vulnerabilities   String?          @db.Text // JSON string
  tradeoffs         String?          @db.Text // JSON string
  sourcesCount      Int              @default(0)
  analyzedAt        DateTime?
  createdAt         DateTime         @default(now())

  comparison        ComparisonReport @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  idea              Idea             @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, ideaId])
  @@index([comparisonId, candidatePosition])
}
