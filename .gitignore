# ============================================================
# DIME — .gitignore
# ============================================================

# ── Dependencies ───────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment & Secret Files (CRITICAL) ──────────────────
.env
.env.*
!.env.example
*.env
*.env.*
!.env.*.example
*.pem
*.key
*firebase-adminsdk*.json
*serviceAccount*.json
/backend/.env
/backend/.env.*


# ── Next.js & Build Outputs ────────────────────────────────
.next/
/out/
/build/
/dist/
*.tsbuildinfo
.vercel/

# ── Local Databases & Backups ──────────────────────────────
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
prisma/prisma/
prisma/schema.prisma.backup
/src/generated/prisma

# ── Python & Virtual Environments ──────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
develop-eggs/
eggs/
.eggs/
parts/
sdist/
wheels/
*.egg
MANIFEST

# ── Testing & Code Quality Caches ──────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ── Logs & Debug Files ─────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
err.txt
backend/err.txt

# ── OS & IDE ───────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo